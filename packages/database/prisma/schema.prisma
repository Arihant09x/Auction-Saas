// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      =  env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  firebaseUid    String    @unique // Link to Firebase Auth
  name           String
  email          String    @unique
  role           Role      @default(USER) // Your Admin Role
  password       String?
  mobile         String?   @unique
  city           String? 
  profileUrl     String?
  createdAt      DateTime  @default(now())
  stripeCustomerId String? @unique
  status         UserStatus @default(ACTIVE)
  deletedAt      DateTime?
  sessionVersion Int       @default(0)
  auctions       Auction[]
  joinedAuctions JoinedAuction[]
  auditLogs      AuditLog[]
  feedback       Feedback?
  blogs          Blog[]
  blogRevisions  BlogRevision[]
  loginHistories LoginHistory[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
  CONTENT_EDITOR
  ANALYST
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  device    String?
  createdAt DateTime @default(now())
}

// 2. The Pricing Plans (Based on Screenshot 17)
enum PlanTier {
  FREE        // Up to 2 Teams
  BASIC       // 3000/- Up to 4 Teams
  STANDARD    // 4000/- Up to 7 Teams
  PREMIUM     // 5000/- Up to 12 Teams
  ELITE       // 6000/- Up to 16 Teams
  ULTIMATE    // 7000/- Up to 22 Teams
  MEGA        // Up to 30 Teams
}
enum AuctionStatus {
  DRAFT
  UPCOMING
  LIVE
  COMPLETED
  ARCHIVED
}

// 3. The Auction Event (The Core)
model Auction {
  id              String      @id @default(uuid())
  auctionCode     String      @unique @default(dbgenerated("gen_random_uuid()"))
  organizerId     String
  organizer       User        @relation(fields: [organizerId], references: [id])
  
  // Basic Info (Screenshot 8 & 14)
  name            String
  location        String?
  logo            String?
  sportsType      String      @default("Cricket")
  season          String?
  auctionDate     DateTime
  auctionStartTime String?    // Stores display time 
  
  // Rules (Screenshot 14)
  budgetPerTeam   Decimal     @default(10000000) // Points/Money
  minBid          Decimal     @default(500)
  bidIncrease     Decimal     @default(500)
  minPlayersPerTeam Int       @default(11)
  maxPlayersPerTeam Int       @default(15)

  // 1. AUTO BOOSTER SETTINGS
  isBoosterEnabled        Boolean @default(false)
  boosterAmount           Int?     @default(0) // Amount to add (e.g., 10000)
  boosterTriggerPlayerCount Int?   @default(0) // Trigger after X players (e.g., 9)

  // 2. DYNAMIC BID INCREMENT RULES
  // We will store this as JSON because rules can be complex (array of rules)
  // Format: [ { "threshold": 2000, "increment": 2000 }, { "threshold": 10000, "increment": 5000 } ]
  bidRules                Json?   @default("[]")
  
  // Payment & Premium Logic 
  planTier        PlanTier    @default(FREE)
  isPaid          Boolean     @default(false)
  // RAZORPAY FIELDS
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?   // To verify authenticity
  
  // State
  status          AuctionStatus @default(UPCOMING) // UPCOMING, LIVE, COMPLETED
  
  // Relations
  teams           Team[]
  players         Player[]
  categories      Category[]
  bidhistories    BidHistory[]
  AuctionInsight  AuctionInsight?
  joinedAuctions  JoinedAuction[]
  
  liveTheme       String      @default("logo-1")
  soldEffect      String      @default("confetti-center")
  overlayTheme    String      @default("default")
  overlayLayout   String      @default("player-card")

  createdAt       DateTime    @default(now())
  ArchivedAt      DateTime?
  // Speed up: "Find all auctions by this organizer"
  @@index([organizerId])
  @@unique([razorpayPaymentId])
  @@index([organizerId, status])
  @@index([status])
}

model JoinedAuction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  
  @@unique([userId, auctionId])
}


// 4. Categories / Sets (Screenshot 4 & 10)
model Category {
  id              String    @id @default(uuid())
  auctionId       String
  auction         Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  
  name            String    // e.g., "Batsman", "Grade A"
  color           String?   // For UI display
  
  // Overrides (Screenshot 10)
  baseBid         Decimal?  // Overrides auction default
  minIncrement    Decimal?
  maxPlayersPerTeam Int?    // Some categories might have limits
  minPlayersPerTeam Int?
  players         Player[]
  @@index([auctionId])
}

// 5. Teams (Screenshot 6, 12, 16)
model Team {
  id              String    @id @default(uuid())
  auctionId       String
  auction         Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  
  name            String
  shortName       String    // e.g. "CSK"
  shortcutKey     String?   // "A", "B", "C" for keyboard bidding
  logo            String?
  
  // Economics
  originalPurse   Decimal
  purseSpent      Decimal   @default(0)
  playersCount    Int       @default(0)
  
  players         Player[]  // Players bought by this team
  bidHistories    BidHistory[]
  // Speed up: "Find all teams in this auction"
  @@index([auctionId])
}

enum PlayerRole {
  // --- Cricket Specific (From your Image) ---
  BATSMAN
  BOWLER
  WICKET_KEEPER
  ALL_ROUNDER
  BATTING_ALL_ROUNDER
  BOWLING_ALL_ROUNDER
  ALL_ROUNDER_WICKET_KEEPER
  BATTER   // Included as per image, even if redundant with Batsman
  
  // --- Football Specific (Added for 30% support) ---
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
  
  // --- Generic ---
  OTHER
}
enum PlayerStatus {
  UPCOMING
  BIDDING   // Currently on screen  
  SOLD
  UNSOLD
}
// 6. Players (Screenshot 5 & 16)
model Player {
  id              String    @id @default(uuid())
  auctionId       String
  auction         Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  
  // Personal Details (Screenshot 5)
  name            String
  mobile          String?
  age             Int
  fatherName      String?
  profilePic      String?   // Cloudinary URL
  
  // Stats (Screenshot 5 - Playing Style)
  role            PlayerRole @default(ALL_ROUNDER)
  battingStyle    String?    // RHB/LHB
  bowlingStyle    String?    // RAF/RAS/
  
  // Specs (Screenshot 5 - Jersey, etc)
  tshirtSize      String?
  trouserSize     String?
  jerseyName      String?
  jerseyNumber    Int?
  
  // Auction Status
  status          PlayerStatus @default(UPCOMING) // UPCOMING, UNSOLD, SOLD
  basePrice       Decimal?
  
  // Sold Details
  teamId          String?
  team            Team?     @relation(fields: [teamId], references: [id])
  soldPrice       Decimal?
  
  bidHistory      BidHistory[]
  // Speed up: "Show me all players in Auction X"
  @@index([auctionId])
  
  // Speed up: "Show me all Batsmen"
  @@index([role])
  
  // Speed up: "Show me players in Category Y"
  @@index([categoryId])
}

// 7. Bid History (For Analytics & "Undo" feature)
model BidHistory {
  id              String    @id @default(uuid())
  playerId        String
  player          Player    @relation(fields: [playerId], references: [id])
  // Relations
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  
  teamId          String
  team      Team    @relation(fields: [teamId], references: [id])
  amount          Decimal
  timestamp       DateTime  @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  action        String   // e.g., "CREATE_AUCTION", "DELETE_PLAYER"
  endpoint      String   // e.g., "/auction"
  details       Json?    // Store the request body or specific IDs
  ipAddress     String?
  userAgent     String?  // Browser/device info
  targetEntity  String?  // e.g., "User", "Auction", etc.
  targetId      String?  // ID of the target entity
  previousValue Json?    // State before mutation
  newValue      Json?    // State after mutation
  createdAt     DateTime @default(now())
  
  // Optional: Relation to User if you want foreign keys
  user      User     @relation(fields: [userId], references: [id])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String   @unique // One feedback per user
  user      User     @relation(fields: [userId], references: [id])
  
  rating    Int      // 1 to 5
  message   String?
  createdAt DateTime @default(now())
}

model AuctionInsight{
  id              String    @id @default(uuid())
  auctionId       String    @unique
  auction         Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  
  data            Json      // Store all insights as JSON (e.g., top teams, player demand, etc)
  
  createdAt       DateTime  @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  mobile    String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==========================================
// ENTERPRISE BLOG CMS MODELS
// ==========================================

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model Blog {
  id              String      @id @default(uuid())
  slug            String      @unique
  title           String
  subtitle        String?
  excerpt         String?
  content         String      @db.Text // Markdown / Rich Text
  blockContent    Json?
  status          BlogStatus  @default(DRAFT)
  
  coverImage      String?     // Cloudinary URL
  thumbnailImage  String?     // Cloudinary URL
  heroImage       String?     // Cloudinary URL
  
  readingTime     Int         @default(3) // In minutes
  viewsCount      Int         @default(0)
  likesCount      Int         @default(0)
  
  isFeatured      Boolean     @default(false)
  isPinned        Boolean     @default(false)
  isTrending      Boolean     @default(false)
  allowComments   Boolean     @default(true)
  
  publishedAt     DateTime?
  scheduledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  authorId        String?
  author          User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  
  seo             BlogSEO?
  categories      BlogCategoryMapping[]
  tags            BlogTagMapping[]
  revisions       BlogRevision[]
  viewsHistory    BlogViewHistory[]
  featuredMeta    FeaturedArticle?
  slugHistories   BlogSlugHistory[]

  @@index([slug])
  @@index([status])
  @@index([status, publishedAt])
  @@index([isFeatured, status])
  @@index([isTrending, status])
  @@index([authorId])
}

model BlogCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?  @default("#072460")
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  blogs       BlogCategoryMapping[]

  @@index([slug])
}

model BlogTag {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  
  blogs       BlogTagMapping[]

  @@index([slug])
}

model BlogCategoryMapping {
  blogId     String
  categoryId String
  blog       Blog         @relation(fields: [blogId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([blogId, categoryId])
  @@index([blogId])
  @@index([categoryId])
}

model BlogTagMapping {
  blogId String
  tagId  String
  blog   Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag    BlogTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
  @@index([blogId])
  @@index([tagId])
}

model BlogSEO {
  id              String   @id @default(uuid())
  blogId          String   @unique
  blog            Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  
  metaTitle       String?
  metaDescription String?
  keywords        String?
  canonicalUrl    String?
  ogImage         String?
  ogType          String?  @default("article")
  twitterCard     String?  @default("summary_large_image")
  structuredData  Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MediaImage {
  id         String   @id @default(uuid())
  publicId   String   @unique // Cloudinary public_id
  secureUrl  String   // Cloudinary secure_url
  width      Int?
  height     Int?
  format     String?
  size       Int?     // In bytes
  altText    String?
  caption    String?
  folder     String?  @default("blog_media")
  createdAt  DateTime @default(now())

  @@index([publicId])
}

model BlogRevision {
  id          String   @id @default(uuid())
  blogId      String
  blog        Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  
  revisionNum Int
  title       String
  subtitle    String?
  excerpt     String?
  content     String   @db.Text
  blockContent Json?
  
  createdBy   String?
  createdUser User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([blogId])
}

model BlogViewHistory {
  id        String   @id @default(uuid())
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  
  ipAddress String?
  userAgent String?
  referrer  String?
  viewedAt  DateTime @default(now())

  @@index([blogId])
  @@index([viewedAt])
}

model FeaturedArticle {
  id        String   @id @default(uuid())
  blogId    String   @unique
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model BlogSlugHistory {
  id        String   @id @default(uuid())
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  oldSlug   String   @unique
  createdAt DateTime @default(now())

  @@index([oldSlug])
}
